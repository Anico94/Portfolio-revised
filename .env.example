# Copy this file to `.env.local` and fill in the value to activate the contact form.
#
# Any endpoint that accepts a JSON POST of { name, email, message } works.
# Formspree:      https://formspree.io/f/xxxxxxxx
# Netlify Forms:  /  (with a form handler configured)
# Your own API:   https://api.example.com/contact
#
# Leave this unset and the form still validates, but tells the visitor it is
# not connected yet instead of failing silently.
VITE_CONTACT_ENDPOINT=
